<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">

        <h1>🐳 Dynamic Docker Web App</h1>

        <p>This application is running inside a Docker container.</p>

        <form action="/greet" method="POST">

            <input
                type="text"
                name="name"
                placeholder="Enter your name"
                required
            >

            <button type="submit">
                Submit
            </button>

        </form>

        <% if (message) { %>

            <div class="message">
                <h2><%= message %></h2>
            </div>

        <% } %>

    </div>

</body>
</html>
